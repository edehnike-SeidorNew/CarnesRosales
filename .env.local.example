# --- Supabase (Project Settings > API) -------------------------------------------
# Copiá este archivo como .env.local y completá las dos variables.
# Mientras no estén seteadas, la app corre en modo demo SOLO en desarrollo (login que
# acepta cualquier email, datos de ejemplo en memoria). En producción (Vercel) son
# obligatorias: si faltan, la app corta con un error en vez de abrirse sin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NO cargues acá la "service_role key" (o "secret key") de Supabase: la app no la
# necesita y, si se filtra, saltea todas las reglas de seguridad.

# Sólo para publicar una demo sin base de datos a propósito (no usar con datos reales):
# NEXT_PUBLIC_ALLOW_MOCK=true

# --- URL publica de la app (recomendado en produccion) ---------------------------
# Se usa en los links de confirmacion de email y de recuperacion de contrasena.
# Local:   http://localhost:3000
# Vercel:  https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=
